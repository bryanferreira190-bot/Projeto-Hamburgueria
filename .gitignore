# ============================================================
#  Dependencias
# ============================================================
node_modules/
.pnp
.pnp.js

# ============================================================
#  SEGREDOS — nunca versionar
#  .env.example fica de fora da regra (nao tem valor real).
#
#  .env.production do storefront e do admin (apps Vite) tambem fica de
#  fora, DE PROPOSITO e SO NESSES DOIS: e apenas a URL publica da API,
#  nunca segredo — vira texto visivel no JS do navegador de qualquer
#  forma. A excecao e por caminho exato, nao "!.env.production" global,
#  para nunca liberar sem querer um .env.production real (com segredo)
#  que venha a existir em apps/api no futuro.
# ============================================================
.env
.env.*
!.env.example
!apps/api/.env.production.example
!apps/storefront/.env.production
!apps/admin/.env.production
*.pem
*.key
secrets/

# ============================================================
#  Builds e cache
# ============================================================
dist/
build/
out/
.next/
.turbo/
.vite/
coverage/
*.tsbuildinfo

# ============================================================
#  Banco de dados
# ============================================================
*.sqlite
*.sqlite3
*.db
prisma/*.db

# ============================================================
#  Logs
# ============================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================================
#  Editores e sistema operacional
# ============================================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.recommended.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
#  Testes e ferramentas
# ============================================================
playwright-report/
test-results/
.playwright/

# ============================================================
#  Repositorio Git aninhado criado por engano
# ============================================================
projeto hbg/
