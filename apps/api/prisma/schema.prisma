// ============================================================================
//  ADVENTURE BURGUER — Schema do banco
//
//  Convencoes deste schema:
//   - Valores monetarios sao Int em CENTAVOS (ver packages/shared/money.ts)
//   - Enums espelham packages/shared/src/domain/enums.ts
//   - storeId presente desde o inicio, para multi-loja no futuro
//   - Precos e enderecos sao COPIADOS no pedido, nunca referenciados
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
//  ENUMS
// ============================================================================

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  AWAITING_PICKUP
  DELIVERED
  COMPLETED
  CANCELED
}

enum OrderType {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH_ON_DELIVERY
  CARD_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  REFUNDED
  FAILED
  CANCELED
}

enum AdminRole {
  DELIVERY
  KITCHEN
  MANAGER
  OWNER
}

enum DiscountType {
  PERCENT
  FIXED
}

// ============================================================================
//  LOJA E OPERACAO
// ============================================================================

model Store {
  id           String  @id @default(uuid()) @db.Uuid
  name         String  @db.VarChar(120)
  slug         String  @unique @db.VarChar(120)
  phone        String  @db.VarChar(20)
  whatsapp     String? @db.VarChar(20)
  email        String? @db.VarChar(160)
  logoUrl      String? @db.VarChar(500)

  // Endereco da loja
  zipCode      String  @db.VarChar(8)
  street       String  @db.VarChar(160)
  number       String  @db.VarChar(20)
  complement   String? @db.VarChar(120)
  district     String  @db.VarChar(120)
  city         String  @db.VarChar(120)
  state        String  @db.VarChar(2)
  latitude     Float?
  longitude    Float?

  // Regras comerciais, em centavos
  minOrderCents        Int     @default(0)
  baseDeliveryFeeCents Int     @default(0)
  avgPrepMinutes       Int     @default(30)

  // Pausa emergencial: interrompe pedidos mesmo dentro do horario
  isOpenOverride Boolean @default(true)
  acceptsDelivery Boolean @default(true)
  acceptsPickup   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessHours BusinessHour[]
  deliveryZones DeliveryZone[]
  categories    Category[]
  products      Product[]
  optionGroups  OptionGroup[]
  coupons       Coupon[]
  orders        Order[]
  admins        AdminUser[]
  customers     Customer[]

  @@map("store")
}

model BusinessHour {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid

  /// 0 = domingo ... 6 = sabado
  weekday   Int
  /// Minutos desde a meia-noite. 18:00 = 1080. Evita fuso e parsing de string.
  opensAt   Int
  closesAt  Int
  isClosed  Boolean @default(false)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, weekday])
  @@map("business_hour")
}

model DeliveryZone {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid

  name          String  @db.VarChar(120)
  district      String? @db.VarChar(120)
  /// Alternativa ao bairro: raio em metros a partir da loja
  radiusMeters  Int?
  feeCents      Int
  etaMinutes    Int     @default(45)
  minOrderCents Int     @default(0)
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, isActive])
  @@map("delivery_zone")
}

// ============================================================================
//  CATALOGO
// ============================================================================

model Category {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid

  name        String  @db.VarChar(120)
  slug        String  @db.VarChar(120)
  description String? @db.VarChar(300)
  imageUrl    String? @db.VarChar(500)
  position    Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([storeId, slug])
  @@index([storeId, isActive, position])
  @@map("category")
}

model Product {
  id         String @id @default(uuid()) @db.Uuid
  storeId    String @db.Uuid
  categoryId String @db.Uuid

  name        String  @db.VarChar(160)
  slug        String  @db.VarChar(160)
  description String? @db.VarChar(600)
  imageUrl    String? @db.VarChar(500)

  priceCents Int
  /// Preco "de", apenas para exibir promocao. Nao entra em nenhum calculo.
  compareAtPriceCents Int?

  position      Int     @default(0)
  isActive      Boolean @default(true)
  isAvailable   Boolean @default(true)
  isFeatured    Boolean @default(false)
  serves        Int?
  prepMinutes   Int?

  /// Soft delete: pedidos antigos precisam continuar legiveis.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store        Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category     Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  optionGroups ProductOptionGroup[]
  orderItems   OrderItem[]
  salesRollups ProductSalesRollup[]

  @@unique([storeId, slug])
  @@index([storeId, isActive, isAvailable])
  @@index([categoryId, position])
  @@map("product")
}

model OptionGroup {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid

  name        String @db.VarChar(120)
  description String? @db.VarChar(300)
  /// Quantas opcoes o cliente deve escolher. min=1 torna o grupo obrigatorio.
  minSelect   Int    @default(0)
  maxSelect   Int    @default(1)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  options  Option[]
  products ProductOptionGroup[]

  @@index([storeId, isActive])
  @@map("option_group")
}

model Option {
  id            String @id @default(uuid()) @db.Uuid
  optionGroupId String @db.Uuid

  name       String  @db.VarChar(120)
  /// Acrescimo em centavos. Pode ser 0 (ex.: "sem cebola").
  priceCents Int     @default(0)
  position   Int     @default(0)
  isActive   Boolean @default(true)
  isDefault  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  optionGroup     OptionGroup       @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  orderItemOptions OrderItemOption[]

  @@index([optionGroupId, position])
  @@map("option")
}

model ProductOptionGroup {
  productId     String @db.Uuid
  optionGroupId String @db.Uuid
  position      Int    @default(0)

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionGroup OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  @@id([productId, optionGroupId])
  @@map("product_option_group")
}

// ============================================================================
//  CLIENTES
// ============================================================================

model Customer {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid

  /// Somente digitos, com DDD. E a identidade do cliente no sistema.
  phone String  @db.VarChar(11)
  name  String? @db.VarChar(120)
  email String? @db.VarChar(160)

  isBlocked Boolean @default(false)
  lastOrderAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store     Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  addresses CustomerAddress[]
  orders    Order[]
  otpCodes  OtpCode[]

  @@unique([storeId, phone])
  @@map("customer")
}

model CustomerAddress {
  id         String @id @default(uuid()) @db.Uuid
  customerId String @db.Uuid

  label      String? @db.VarChar(40)
  zipCode    String  @db.VarChar(8)
  street     String  @db.VarChar(160)
  number     String  @db.VarChar(20)
  complement String? @db.VarChar(120)
  district   String  @db.VarChar(120)
  city       String  @db.VarChar(120)
  state      String  @db.VarChar(2)
  reference  String? @db.VarChar(160)
  latitude   Float?
  longitude  Float?

  isDefault Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, deletedAt])
  @@map("customer_address")
}

model OtpCode {
  id         String  @id @default(uuid()) @db.Uuid
  customerId String? @db.Uuid

  phone String @db.VarChar(11)
  /// Hash do codigo, nunca o codigo em texto puro.
  codeHash  String   @db.VarChar(200)
  expiresAt DateTime
  attempts  Int      @default(0)
  consumedAt DateTime?

  createdAt DateTime @default(now())

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([phone, expiresAt])
  @@map("otp_code")
}

// ============================================================================
//  CUPONS
// ============================================================================

model Coupon {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid

  code         String       @db.VarChar(40)
  description  String?      @db.VarChar(200)
  discountType DiscountType
  /// Percentual (1-100) ou valor em centavos, conforme discountType.
  discountValue Int
  maxDiscountCents Int?
  minOrderCents    Int     @default(0)

  usageLimit      Int?
  usageCount      Int  @default(0)
  perCustomerLimit Int @default(1)

  startsAt DateTime?
  endsAt   DateTime?
  isActive Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([storeId, code])
  @@index([storeId, isActive])
  @@map("coupon")
}

// ============================================================================
//  PEDIDOS
// ============================================================================

model Order {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid

  /// Numero curto mostrado ao cliente e gritado na cozinha. Ex.: "A312"
  number String @db.VarChar(12)

  customerId String @db.Uuid
  couponId   String? @db.Uuid

  type   OrderType
  status OrderStatus @default(PENDING_PAYMENT)

  // ----- Valores, todos em centavos, todos calculados no servidor -----
  subtotalCents    Int
  deliveryFeeCents Int @default(0)
  discountCents    Int @default(0)
  totalCents       Int

  paymentMethod PaymentMethod
  /// Para levar troco. Apenas quando o pagamento e em dinheiro.
  changeForCents Int?

  // ----- Endereco CONGELADO no momento do pedido -----
  // Copiado de proposito: se o cliente editar o endereco depois, a entrega
  // ja realizada deve continuar refletindo para onde de fato foi.
  addressZipCode    String? @db.VarChar(8)
  addressStreet     String? @db.VarChar(160)
  addressNumber     String? @db.VarChar(20)
  addressComplement String? @db.VarChar(120)
  addressDistrict   String? @db.VarChar(120)
  addressCity       String? @db.VarChar(120)
  addressState      String? @db.VarChar(2)
  addressReference  String? @db.VarChar(160)

  notes String? @db.VarChar(300)

  /// Impede pedido duplicado quando o cliente clica duas vezes em "Finalizar".
  idempotencyKey String? @db.VarChar(80)

  confirmedAt DateTime?
  readyAt     DateTime?
  deliveredAt DateTime?
  canceledAt  DateTime?
  cancelReason String? @db.VarChar(200)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store         Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  customer      Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  coupon        Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]

  @@unique([storeId, number])
  @@unique([storeId, idempotencyKey])
  @@index([storeId, status, createdAt])
  @@index([storeId, createdAt])
  @@index([customerId, createdAt])
  @@map("order")
}

model OrderItem {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid

  productId String @db.Uuid
  /// Nome copiado: o produto pode ser renomeado ou removido depois.
  productName String @db.VarChar(160)

  quantity   Int
  /// Preco unitario COPIADO do produto no instante do pedido.
  unitPriceCents Int
  /// Soma dos adicionais escolhidos, por unidade.
  optionsPriceCents Int @default(0)
  /// (unitPrice + optionsPrice) * quantity
  totalCents Int

  notes String? @db.VarChar(200)

  order   Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  options OrderItemOption[]

  @@index([orderId])
  @@index([productId])
  @@map("order_item")
}

model OrderItemOption {
  id          String @id @default(uuid()) @db.Uuid
  orderItemId String @db.Uuid

  optionId   String @db.Uuid
  optionName String @db.VarChar(120)
  priceCents Int    @default(0)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  option    Option    @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
  @@map("order_item_option")
}

model OrderStatusHistory {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid

  fromStatus OrderStatus?
  toStatus   OrderStatus
  /// Quem mudou: id do admin, ou null quando foi o sistema (ex.: webhook).
  changedByAdminId String? @db.Uuid
  reason String? @db.VarChar(200)

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ============================================================================
//  PAGAMENTOS
// ============================================================================

model Payment {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid

  provider String        @db.VarChar(40)
  method   PaymentMethod
  status   PaymentStatus @default(PENDING)

  amountCents Int

  /// Identificador do pagamento no provedor.
  externalId String? @db.VarChar(120)
  /// Enviada ao provedor para nao cobrar duas vezes na mesma tentativa.
  idempotencyKey String? @db.VarChar(80)

  pixQrCode      String? @db.Text
  pixCopyPaste   String? @db.Text
  pixExpiresAt   DateTime?

  paidAt     DateTime?
  refundedAt DateTime?
  failureReason String? @db.VarChar(300)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([orderId])
  @@index([status])
  @@map("payment")
}

model PaymentWebhookEvent {
  id String @id @default(uuid()) @db.Uuid

  provider  String @db.VarChar(40)
  eventId   String @db.VarChar(160)
  eventType String @db.VarChar(80)

  /// Corpo bruto guardado para reprocessar caso o tratamento falhe.
  payload Json

  processedAt DateTime?
  error       String?   @db.Text

  createdAt DateTime @default(now())

  /// Garante que o mesmo evento nao seja processado duas vezes.
  @@unique([provider, eventId])
  @@index([processedAt])
  @@map("payment_webhook_event")
}

// ============================================================================
//  ADMINISTRACAO E SEGURANCA
// ============================================================================

model AdminUser {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid

  name  String @db.VarChar(120)
  email String @db.VarChar(160)
  /// Hash Argon2id. Nunca a senha.
  passwordHash String @db.VarChar(255)

  role AdminRole @default(KITCHEN)

  /// Segredo TOTP, cifrado em repouso. Obrigatorio para OWNER e MANAGER.
  totpSecret     String?  @db.VarChar(255)
  totpEnabledAt  DateTime?

  isActive         Boolean   @default(true)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@unique([storeId, email])
  @@index([storeId, isActive])
  @@map("admin_user")
}

model RefreshToken {
  id          String @id @default(uuid()) @db.Uuid
  adminUserId String @db.Uuid

  /// Hash do token. Vazamento do banco nao entrega sessao valida.
  tokenHash String @db.VarChar(255)

  /// Agrupa a cadeia de rotacoes. Detectado reuso, revoga-se a familia toda.
  familyId String @db.Uuid

  expiresAt  DateTime
  revokedAt  DateTime?
  replacedById String? @db.Uuid

  userAgent String? @db.VarChar(300)
  ipAddress String? @db.VarChar(45)

  createdAt DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([adminUserId, revokedAt])
  @@index([familyId])
  @@map("refresh_token")
}

model AuditLog {
  id          String  @id @default(uuid()) @db.Uuid
  adminUserId String? @db.Uuid

  action     String  @db.VarChar(80)
  entityType String  @db.VarChar(60)
  entityId   String? @db.VarChar(80)

  /// Valores antes e depois, para reconstruir o que mudou.
  before Json?
  after  Json?

  ipAddress String? @db.VarChar(45)
  userAgent String? @db.VarChar(300)

  createdAt DateTime @default(now())

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

// ============================================================================
//  RELATORIOS (agregados pre-calculados)
//
//  O dashboard le daqui, e nao da tabela order. Varrer todos os pedidos para
//  montar grafico funciona no primeiro mes e trava no sexto.
// ============================================================================

model DailySalesRollup {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid

  /// Dia de referencia, normalizado a meia-noite.
  date DateTime @db.Date

  ordersCount    Int @default(0)
  canceledCount  Int @default(0)
  grossCents     Int @default(0)
  discountCents  Int @default(0)
  deliveryFeeCents Int @default(0)
  netCents       Int @default(0)
  avgTicketCents Int @default(0)

  deliveryCount Int @default(0)
  pickupCount   Int @default(0)

  /// Contagem por forma de pagamento: { "PIX": 12, "CREDIT_CARD": 5 }
  byPaymentMethod Json?
  /// Pedidos por hora do dia: { "18": 3, "19": 11, ... }
  byHour Json?

  updatedAt DateTime @updatedAt

  @@unique([storeId, date])
  @@index([storeId, date])
  @@map("daily_sales_rollup")
}

model ProductSalesRollup {
  id        String @id @default(uuid()) @db.Uuid
  storeId   String @db.Uuid
  productId String @db.Uuid

  date DateTime @db.Date

  quantity   Int @default(0)
  grossCents Int @default(0)

  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId, date])
  @@index([storeId, date])
  @@map("product_sales_rollup")
}
