# ============================================================
#  VARIAVEIS DE AMBIENTE DE PRODUCAO — RAILWAY
#
#  Este arquivo NAO tem valores reais e PODE ficar versionado (e so
#  um guia). Cole cada uma dessas chaves na aba "Variables" do Railway,
#  com o valor de verdade — nunca aqui, nunca no chat.
# ============================================================

NODE_ENV=production
PORT=3333

# ---------- Banco de dados ----------
# A MESMA connection string do Neon que ja esta em uso.
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require

# ---------- Autenticacao ----------
# Gere um valor NOVO para cada uma das tres (nunca reaproveite as do
# .env local), rodando no seu terminal:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# As tres precisam ser DIFERENTES entre si — o loadEnv() recusa subir
# se duas forem iguais.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ENCRYPTION_KEY=

# ---------- Bloqueio de login ----------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Em producao este valor e ignorado pelo codigo e SEMPRE vira true —
# fica aqui so como lembrete do comportamento.
REQUIRE_ADMIN_2FA=true

# ---------- Endereco publico da API ----------
# Prefixo das URLs de foto de produto devolvidas pelo cardapio. Sem isto a
# API devolve caminho relativo ("/api/v1/catalog/..."), que a loja ate
# consegue resolver, mas so porque ela conhece VITE_API_URL — qualquer
# outro consumidor (WhatsApp, Mercado Pago, um app futuro) receberia uma
# URL que nao abre. Sem barra no fim.
PUBLIC_API_URL=https://api.impactdev.site

# ---------- CORS ----------
# Os tres dominios que vao CHAMAR a API. Sem http://localhost aqui.
CORS_ORIGINS=https://impactdev.site,https://loja.impactdev.site,https://painel.impactdev.site

# ---------- Mercado Pago (PIX) ----------
# ACCESS_TOKEN: painel do Mercado Pago -> Suas integracoes -> a aplicacao
# -> Credenciais de teste (ou de producao, quando sair do teste).
# WEBHOOK_SECRET: mesma tela -> Webhooks -> Configurar notificacoes ->
# cadastre https://api.impactdev.site/api/v1/payments/webhook, evento
# "Pagamentos", e copie a "Assinatura secreta" mostrada ali.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ---------- WhatsApp Cloud API (Meta) ----------
# Usado hoje pelo aviso automatico de cashback expirando.
#
# ENQUANTO ESTIVER VAZIO, NADA QUEBRA: o sistema registra no log o que
# teria enviado e o resto do cashback (creditar, resgatar, o painel)
# funciona normalmente. Preencher so quando a conta Meta estiver pronta.
#
# Numero comercial, so para exibicao (ex.: 5511972356429).
WHATSAPP_PHONE_NUMBER=
# Token PERMANENTE de System User. Meta Business -> Configuracoes ->
# Usuarios do sistema -> gerar token com as permissoes whatsapp_business_messaging
# e whatsapp_business_management. O token temporario de 24h NAO serve.
WHATSAPP_TOKEN=
# Id do numero DENTRO do WhatsApp Business, nao o telefone.
# WhatsApp Manager -> Numeros de telefone -> copiar "ID do numero de telefone".
WHATSAPP_PHONE_NUMBER_ID=
# Nome exato do template aprovado. Deixe como esta se usar o nome sugerido.
WHATSAPP_TEMPLATE_CASHBACK=cashback_expirando
