# ============================================================
#  MODELO DE AMBIENTE
#  Copie para .env e preencha com os valores reais.
#  Este arquivo E versionado; o .env NAO.
# ============================================================

NODE_ENV=development
PORT=3333

# ---------- Banco de dados ----------
# Neon: https://neon.tech (plano gratuito)
DATABASE_URL="postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require"

# ---------- Redis ----------
# Upstash: https://upstash.com (plano gratuito)
REDIS_URL="rediss://default:senha@host.upstash.io:6379"

# ---------- Autenticacao ----------
# Gerar cada segredo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Cifra o segredo TOTP em repouso. Precisa ser DIFERENTE dos segredos JWT.
# Trocar esta chave invalida todos os 2FA ja configurados.
ENCRYPTION_KEY=

# Bloqueio temporario da conta apos falhas de senha
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Exige 2FA para OWNER e MANAGER. Use false apenas em desenvolvimento;
# em producao o valor e forcado para true pela propria aplicacao.
REQUIRE_ADMIN_2FA=true

# ---------- CORS ----------
# Origens permitidas, separadas por virgula
CORS_ORIGINS=http://localhost:4000,http://localhost:5173,http://localhost:5174

# ---------- Mercado Pago ----------
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ---------- WhatsApp ----------
# Fase 1: numero da loja no formato internacional, so digitos (ex.: 5511999999999)
WHATSAPP_PHONE_NUMBER=

# ---------- Notificacoes automaticas de pedido (Evolution API) ----------
# "none" (padrao) desliga tudo -- nao precisa preencher nada em dev.
WHATSAPP_PROVIDER=none
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
