# Aplicado automaticamente pelo Vite quando roda "npm run build" (modo
# producao). Nao e segredo: VITE_* vira texto visivel no JS do navegador,
# por isso pode ficar versionado.
VITE_API_URL=https://api.impactdev.site/api/v1

# Chave PUBLICA do Mercado Pago. Diferente do Access Token, ela e feita
# para ficar exposta no navegador: so serve para transformar os dados do
# cartao em token, nunca para cobrar. E por isso que ela pode ficar aqui
# versionada, e o Access Token so no Railway.
VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-5c7c966d-92ff-4a6b-9e01-deec1057be88
