{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build --workspace=@adventure/shared && npm run build --workspace=@adventure/storefront"
  },
  "deploy": {
    "startCommand": "npm run start --workspace=@adventure/storefront",
    "healthcheckPath": "/",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
